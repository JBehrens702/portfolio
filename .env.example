# Copy this file to .env.local and fill in the DEVELOPMENT values from the
# Vercel dashboard (Settings -> Environment Variables). .env.local is ignored by git.
# Never put Production values in .env.local.

# Vercel Blob (Development/Preview store)
BLOB_READ_WRITE_TOKEN=

# Random path segment that hides the draft and history documents (KTD2)
CONTENT_PATH_SECRET=
# Root folder for all content in the store; tests use their own root
CONTENT_ROOT=site

# Clerk (admin sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The Clerk user ID of the site owner; only this user may change content
ADMIN_USER_ID=
