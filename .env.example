# Copy this file to .env.local and fill in the DEVELOPMENT values from the
# Vercel dashboard (Settings -> Environment Variables). .env.local is ignored by git.
# WARNING: never put Production values (BLOB_READ_WRITE_TOKEN, the Production
# CONTENT_PATH_SECRET) in .env.local. Local work would then change the live site.

# Vercel Blob, development store (Vercel prefix "DEV"). Only a Production
# deployment uses BLOB_READ_WRITE_TOKEN; everything else uses this token.
DEV_READ_WRITE_TOKEN=

# Exact public hostnames of the two Blob stores, comma-separated, no wildcards
# (for next/image). Example: abc123.public.blob.vercel-storage.com
BLOB_PUBLIC_HOSTNAMES=

# Random path segment that hides the draft and history (KTD2); the
# Preview/Development value, at least 16 letters or digits
CONTENT_PATH_SECRET=
# Root folder for all content in the store
CONTENT_ROOT=site
# Optional: "file:<folder>" reads local JSON files instead of Blob (tests use
# file:e2e/fixtures/content). Leave empty to use Blob.
CONTENT_SOURCE=

# Clerk (admin sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The Clerk user ID of the site owner (starts with user_); only this user may change content
ADMIN_USER_ID=
